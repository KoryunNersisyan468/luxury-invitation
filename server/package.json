{
  "name": "luxury-wedding-invitations-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for a luxury wedding invitation platform.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch src --watch prisma",
    "lint": "npx eslint . --ext .js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.37.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "google-auth-library": "^9.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.20.2",
    "uuid": "^9.0.1",
    "xss-clean": "^0.1.1",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
